OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only, and never NEXT_PUBLIC_: this key bypasses row level security and is what
# lets the Stripe webhook write credit nobody else may write.
SUPABASE_SERVICE_ROLE_KEY=
# Prefer a restricted key (rk_) limited to Checkout Sessions; a full secret key can do far
# more than this app ever needs. Leave both blank to run with top-ups switched off.
STRIPE_SECRET_KEY=
# From `stripe listen` in development, or the endpoint's signing secret in the Dashboard.
STRIPE_WEBHOOK_SECRET=
# The link behind a personal Alipay receive code, e.g. https://qr.alipay.com/xxxxxxxx. Money
# goes straight to that Alipay account, and nothing reports back that it arrived - the top-up
# is recorded because the learner said so. Demo only; see docs/alipay-credit.md. Blank = off.
ALIPAY_QR_URL=
